<Window x:Class="LogAnalyser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Analyser" Height="800" Width="1280"
        MinHeight="550" MinWidth="850"
        WindowState="Maximized"
        Icon="app_logo.png"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, System-UI" FontSize="13">

  <Window.Resources>
    <!-- Common Button Style -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.85"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Filter Button Style -->
    <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Toolbar -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="Select Log File" Click="OnSelectFolder"
              FontWeight="SemiBold" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF"
              BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,12,0"
              VerticalAlignment="Center"/>

      <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center" Margin="0,0,12,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="FilePathText" Text="No file or folder selected"
                     Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="1" x:Name="AutoRefresh" Content="Auto-refresh (2s)" Margin="12,0,0,0"
                    Click="OnAutoRefreshToggle" IsChecked="True" VerticalAlignment="Center"/>
          <CheckBox Grid.Column="2" x:Name="LiveTailCheckBox" Content="Live Tail" Margin="12,0,0,0"
                    IsChecked="False" VerticalAlignment="Center" ToolTip="Automatically scroll to bottom on new logs"/>
        </Grid>
      </Border>

      <Button Grid.Column="2" Content="Top" Click="OnScrollToTop"
              Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Scroll to top of logs"/>

      <Button Grid.Column="3" Content="Bottom" Click="OnScrollToBottom"
              Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Scroll to bottom of logs"/>

      <Button Grid.Column="4" Content="Export" Click="OnExportClicked"
              Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Export filtered logs to TXT, CSV, or JSON"/>

      <Button Grid.Column="5" Content="Clear" Click="OnClearClicked"
              Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Clear loaded entries"/>

      <Button Grid.Column="6" x:Name="ThemeToggleButton" Content="Dark Mode" Click="OnToggleTheme"
              Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Toggle Light/Dark Theme"/>

      <Button Grid.Column="7" Content="Reload" Click="OnReloadClicked"
              Style="{StaticResource FilterButtonStyle}" VerticalAlignment="Center" ToolTip="Reload log file"/>
    </Grid>

    <!-- Category Filters & Search Bar -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Level:" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
        <Button x:Name="BtnAll" Content="ALL (0)" Click="OnFilterLevel" Tag="ALL" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnCrt" Content="CRT (0)" Click="OnFilterLevel" Tag="CRT" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnErr" Content="ERR (0)" Click="OnFilterLevel" Tag="ERR" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnWrn" Content="WRN (0)" Click="OnFilterLevel" Tag="WRN" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnInf" Content="INF (0)" Click="OnFilterLevel" Tag="INF" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnDbg" Content="DBG (0)" Click="OnFilterLevel" Tag="DBG" Style="{StaticResource FilterButtonStyle}"/>
        <Button x:Name="BtnTrc" Content="TRC (0)" Click="OnFilterLevel" Tag="TRC" Style="{StaticResource FilterButtonStyle}"/>
      </StackPanel>

      <!-- Search Controls (with Clear button, Regex & Match Case toggles) -->
      <Grid Grid.Column="2" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" x:Name="FilterText" TextChanged="OnFilterChanged"
                 ToolTip="Search message or timestamp..."/>

        <Button Grid.Column="1" x:Name="ClearSearchButton" Content="✕" Click="OnClearSearchClicked"
                Style="{StaticResource FilterButtonStyle}" Margin="4,0,0,0" Padding="6,2"
                ToolTip="Clear Search" Visibility="Collapsed"/>

        <CheckBox Grid.Column="2" x:Name="MatchCaseCheckBox" Content="Aa" Margin="8,0,0,0"
                  Click="OnFilterOptionChanged" ToolTip="Match Case"/>

        <CheckBox Grid.Column="3" x:Name="RegexCheckBox" Content=".*" Margin="8,0,0,0"
                  Click="OnFilterOptionChanged" ToolTip="Enable Regex Search"/>
      </Grid>
    </Grid>

    <!-- DataGrid for Logs -->
    <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
      <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource GridRowAltBgBrush}"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                FontSize="12" FontFamily="Consolas, Cascadia Code, Segoe UI"
                LoadingRow="LogGrid_LoadingRow" SelectionChanged="LogGrid_SelectionChanged"
                CanUserReorderColumns="True" CanUserResizeRows="False"
                IsReadOnly="True"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
          </Style>
          <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DataGrid.Resources>

        <DataGrid.Columns>
          <DataGridTextColumn Header="Timestamp" Binding="{Binding Time}" Width="200" FontWeight="Medium"/>
          <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" FontWeight="Bold"/>
          <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" FontWeight="Normal"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Selected Entry Detail Drawer -->
    <Border Grid.Row="3" x:Name="DetailDrawer" Visibility="Collapsed" Margin="0,10,0,0"
            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header of detail drawer -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Selected Entry Details" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
            <TextBlock x:Name="DetailTimeText" Text="Time: -" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,12,0"/>
            <TextBlock x:Name="DetailLevelText" Text="Level: -" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
          </StackPanel>

          <Button Grid.Column="1" Content="Copy Log" Click="OnCopySelectedLog" Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0"/>
          <Button Grid.Column="2" Content="Close" Click="OnCloseDetailDrawer" Style="{StaticResource FilterButtonStyle}" Padding="8,2"/>
        </Grid>

        <!-- Full log text display area -->
        <TextBox Grid.Row="1" x:Name="DetailMessageText" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="12"
                 Background="{DynamicResource WindowBgBrush}"/>
      </Grid>
    </Border>

    <!-- Bottom Status & About Bar -->
    <Border Grid.Row="4" Margin="0,10,0,0" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: about.txt information displayed in an elegant pill badge layout -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
            <TextBlock Text="Log Analyser" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
          </Border>

          <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
            <TextBlock x:Name="AboutVersionText" Text="v1.0.2" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Border>

          <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
            <TextBlock x:Name="AboutBuildText" Text="Build 102" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          </Border>

          <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
            <TextBlock x:Name="AboutReleaseText" Text="2026.10.06" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
          </Border>
        </StackPanel>

        <!-- Right Side: Live Entry Metrics -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusMetricsText" Text="Ready • Select a file to start"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="Medium"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
