<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Eye-Comfort Soft Light Theme -->
  <Color x:Key="WindowBgColor">#F1F5F9</Color>
  <Color x:Key="HeaderBgColor">#FFFFFF</Color>
  <Color x:Key="CardBgColor">#FFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#0F172A</Color>
  <Color x:Key="TextMutedColor">#64748B</Color>
  <Color x:Key="BorderColor">#CBD5E1</Color>
  <Color x:Key="AccentColor">#0284C7</Color>

  <SolidColorBrush x:Key="WindowBgBrush" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
  <SolidColorBrush x:Key="InputBgBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="GridHeaderBgBrush" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="GridRowAltBgBrush" Color="#F8FAFC"/>
</ResourceDictionary>
